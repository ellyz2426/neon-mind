<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 6;
      gap: 4;
      background-color: rgba(0, 8, 24, 0.8);
      border-radius: 6;
      border-color: #224488;
      border-width: 1;
      width: 240;
    }
    .row {
      flex-direction: row;
      gap: 8;
      justify-content: center;
    }
    .label {
      font-size: 10;
      color: #88aacc;
    }
    .value {
      font-size: 10;
      color: #00ffcc;
    }
    .feedback {
      font-size: 9;
      color: #ccddee;
    }
    .mode-info {
      font-size: 8;
      color: #667788;
    }
  </style>
  <container class="root">
    <container class="row">
      <text name="guess-count" class="value">Guess 1 / 10</text>
      <text name="timer" class="value">Time: 0s</text>
    </container>
    <text name="color-name" class="label">Color: Red</text>
    <text name="feedback" class="feedback">Place pegs and submit</text>
    <text name="mode-label" class="mode-info">classic / medium</text>
  </container>
</panel>
