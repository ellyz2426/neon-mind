<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 12;
      gap: 4;
      background-color: rgba(0, 8, 24, 0.92);
      border-radius: 8;
      border-color: #224488;
      border-width: 1;
      width: 260;
    }
    .title {
      font-size: 14;
      color: #00ffff;
    }
    .section {
      font-size: 10;
      color: #66aacc;
      margin-top: 4;
    }
    .stat {
      font-size: 9;
      color: #aabbcc;
    }
    .daily-stat {
      font-size: 9;
      color: #ffcc00;
    }
    .back-btn {
      font-size: 9;
      color: #aabbcc;
      background-color: #1a1a3e;
      padding: 6;
      border-radius: 4;
      cursor: pointer;
      margin-top: 6;
    }
  </style>
  <container class="root">
    <text class="title">STATISTICS</text>
    <text class="section">Overall</text>
    <text name="stat-played" class="stat">Games Played: 0</text>
    <text name="stat-wins" class="stat">Wins: 0</text>
    <text name="stat-losses" class="stat">Losses: 0</text>
    <text name="stat-winrate" class="stat">Win Rate: 0%</text>
    <text name="stat-streak" class="stat">Current Streak: 0</text>
    <text name="stat-beststreak" class="stat">Best Streak: 0</text>
    <text name="stat-avgguesses" class="stat">Avg Guesses: -</text>
    <text name="stat-perfect" class="stat">Perfect Games: 0</text>
    <text name="stat-fastest" class="stat">Fastest Win: -</text>
    <text class="section">Daily Challenge</text>
    <text name="stat-daily-streak" class="daily-stat">Daily Streak: 0</text>
    <text class="section">By Difficulty</text>
    <text name="stat-easy" class="stat">easy: 0/0</text>
    <text name="stat-medium" class="stat">medium: 0/0</text>
    <text name="stat-hard" class="stat">hard: 0/0</text>
    <text class="section">By Mode</text>
    <text name="stat-mode-classic" class="stat">Classic: 0/0</text>
    <text name="stat-mode-speed" class="stat">Speed: 0/0</text>
    <text name="stat-mode-zen" class="stat">Zen: 0/0</text>
    <text name="stat-mode-challenge" class="stat">Challenge: 0/0</text>
    <text name="stat-mode-daily" class="daily-stat">Daily: 0/0</text>
    <text class="section">Best Games</text>
    <text name="lb-title" class="stat" style="color: #00ffcc;"></text>
    <text name="lb-0" class="stat"></text>
    <text name="lb-1" class="stat"></text>
    <text name="lb-2" class="stat"></text>
    <text name="lb-3" class="stat"></text>
    <text name="lb-4" class="stat"></text>
    <text name="btn-back" class="back-btn">Back</text>
  </container>
</panel>
