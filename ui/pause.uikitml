<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 12;
      gap: 8;
      background-color: rgba(0, 8, 24, 0.92);
      border-radius: 8;
      border-color: #224488;
      border-width: 1;
      width: 240;
    }
    .title {
      font-size: 14;
      color: #ffcc00;
    }
    .btn {
      font-size: 10;
      color: #ccddee;
      background-color: #222244;
      padding: 8;
      border-radius: 4;
      cursor: pointer;
      min-width: 120;
      text-align: center;
    }
    .btn-primary {
      font-size: 10;
      color: #000000;
      background-color: #00ffcc;
      padding: 8;
      border-radius: 4;
      cursor: pointer;
      min-width: 120;
      text-align: center;
    }
    .hint-btn {
      font-size: 10;
      color: #ffcc00;
      background-color: #332200;
      padding: 8;
      border-radius: 4;
      cursor: pointer;
      min-width: 120;
      text-align: center;
    }
  </style>
  <container class="root">
    <text class="title">PAUSED</text>
    <text name="btn-resume" class="btn-primary">Resume</text>
    <text name="btn-hint" class="hint-btn">Use Hint</text>
    <text name="btn-settings" class="btn">Settings</text>
    <text name="btn-menu" class="btn">Main Menu</text>
  </container>
</panel>
